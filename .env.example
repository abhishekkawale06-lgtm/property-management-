# =============================================
# PG Manager - Environment Configuration
# =============================================
# Copy this file to .env and fill in the values.
# cp .env.example .env

# Flask environment: 'development' or 'production'
FLASK_ENV=development

# Secret key for JWT token signing.
# IMPORTANT: In production, use a strong random string (e.g. openssl rand -hex 32)
JWT_SECRET=change-this-to-a-strong-random-secret

# Admin password used when seeding the database for the first time.
# If not set, a secure random password will be generated and printed to the console.
ADMIN_PASSWORD=
